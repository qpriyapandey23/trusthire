PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/trusthire
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
GITHUB_TOKEN=optional_github_token_for_rate_limits
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Gmail SMTP — must be a Google App Password, NOT your account password.
# Enable 2-Step Verification then generate one at:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# OTP settings (optional — these are the defaults)
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
